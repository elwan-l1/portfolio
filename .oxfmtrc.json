{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".output/**",
    ".nitro/**",
    ".tanstack/**",
    "dist/**",
    "app/routeTree.gen.ts",
    "generated/**",
    "pnpm-lock.yaml",
    "public/**",
    "assets/**"
  ],
  "sortImports": {
    "newlinesBetween": true,
    "customGroups": [
      { "groupName": "react", "elementNamePattern": ["react"] },
      { "groupName": "ui", "elementNamePattern": ["@/components/ui/**"] },
      { "groupName": "components", "elementNamePattern": ["@/components/**"] },
      {
        "groupName": "lib",
        "elementNamePattern": [
          "@prisma/**",
          "@/generated/**",
          "@/types/**",
          "@/core/**",
          "@/lib/**"
        ]
      },
      { "groupName": "hooks", "elementNamePattern": ["@/hooks/**", "@/contexts/**", "@/stores/**"] }
    ],
    "groups": ["react", "ui", "components", "lib", "hooks", "unknown"]
  },
  "sortTailwindcss": { "functions": ["cn", "cva", "clsx"] }
}
